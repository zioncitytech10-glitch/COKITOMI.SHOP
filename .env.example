# CJdropshipping API credentials (create/store only in Render environment settings)
CJ_API_KEY=replace_with_CJ_API_key
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# Supabase backend credentials (legacy service_role JWT or modern sb_secret_ key; server only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Comma-separated Supabase Auth user UUIDs allowed to use admin endpoints
ADMIN_USER_IDS=replace_with_admin_supabase_auth_user_uuid

# Exact storefront origins, comma-separated; no wildcard when using admin auth
COKITOMI_ALLOWED_ORIGINS=https://zioncitytech10-glitch.github.io

# Generate a unique random value of at least 32 characters; store only in Render.
DIAGNOSTIC_BEARER_TOKEN=replace_with_random_diagnostic_bearer_token

# Render supplies PORT automatically; this is a local default
PORT=10000

# Discovery limits and transparent estimate assumptions
CJ_MAX_CANDIDATES=20
CJ_REQUEST_INTERVAL_MS=1100
DISCOVERY_RETAIL_MULTIPLIER=2.5
ESTIMATED_PAYMENT_FEE_RATE=0.03
