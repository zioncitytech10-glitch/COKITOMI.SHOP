# CJdropshipping credentials. Keep actual values in Render environment settings.
CJ_API_KEY=replace_with_CJ_API_key
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# Supabase backend credentials. SUPABASE_SERVICE_ROLE_KEY accepts legacy
# service_role JWT keys or modern sb_secret_ keys; keep either server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_or_secret_key

# Comma-separated Supabase Auth user UUIDs allowed to use admin endpoints.
ADMIN_USER_IDS=replace_with_admin_supabase_auth_user_uuid

# Exact browser origins (origin only, no page path). Add a custom domain if used.
COKITOMI_ALLOWED_ORIGINS=https://zioncitytech10-glitch.github.io

# Render supplies PORT automatically; these discovery/scoring values have defaults.
PORT=10000
CJ_MAX_CANDIDATES=20
CJ_REQUEST_INTERVAL_MS=1100
DISCOVERY_RETAIL_MULTIPLIER=2.5
ESTIMATED_PAYMENT_FEE_RATE=0.03
